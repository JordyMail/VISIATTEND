{
  "name": "fusion-starter",
  "private": true,
  "type": "module",
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ] 
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:frontend\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node dist/server/node-build.mjs",
    "db:test": "tsx server/db/test.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:v2": "tsx server/db/migrate_v2.ts",
    "db:migrate:user_member": "tsx server/db/migrate_user_member.ts",
    "db:migrate:attendance_schedule": "tsx server/db/migrate_attendance_schedule.ts",
    "db:migrate:event_date": "tsx server/db/migrate_event_date.ts",
    "db:migrate:event_schedule": "tsx server/db/migrate_event_schedule.ts",
    "db:migrate:attendance_event_code": "tsx server/db/migrate_attendance_event_code.ts",
    "db:migrate:attendance_summary": "tsx server/db/migrate_attendance_summary.ts",
    "db:migrate:questions": "tsx server/db/migrate_questions.ts",
    "db:migrate:regular_event": "tsx server/db/migrate_regular_event.ts",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:v2 && npm run db:migrate:user_member && npm run db:migrate:attendance_schedule && npm run db:migrate:event_date && npm run db:migrate:event_schedule && npm run db:migrate:attendance_event_code && npm run db:migrate:attendance_summary && npm run db:migrate:questions && npm run db:migrate:regular_event",
    "db:seed": "tsx server/db/seed.ts",
    "db:seed:v2": "tsx server/db/seed_v2.ts",
    "db:setup": "npm run db:migrate:all && npm run db:seed",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc",
    "dev:server": "tsx server/server.ts",
    "dev:api": "tsx server/server.ts",
    "dev:frontend": "vite --port 5173"
  },
  "dependencies": {
    "@types/crypto-js": "^4.2.2",
